# Copy this file to .env and fill in your values.
# .env is git-ignored and never committed.

ANTHROPIC_API_KEY=your-api-key-here

# BIZBRIEF_API_KEY — shared secret for write endpoints (PUT /api/schedule).
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Never hard-code or log this value.
BIZBRIEF_API_KEY=change-me-before-use

# FORWARDED_ALLOW_IPS — controls which IPs uvicorn trusts as a reverse proxy.
# SECURITY: leave this empty (default) unless you are running behind a known,
# trusted reverse proxy that you control.  Setting it to "127.0.0.1" (uvicorn's
# default) allows any localhost client to spoof X-Forwarded-For and bypass all
# per-IP rate-limiting and auth-failure lockout (RT-001).
#
# The CORRECT way to start the server is:
#   uv run python -m api.run
# api/run.py passes forwarded_allow_ips=[] directly to uvicorn.run(), which is
# the only reliable way to prevent uvicorn from trusting XFF headers.  The env
# var below is honored only when using the uvicorn CLI directly (not recommended).
FORWARDED_ALLOW_IPS=
